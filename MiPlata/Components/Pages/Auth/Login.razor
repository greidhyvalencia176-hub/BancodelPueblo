@page "/"
@rendermode InteractiveServer
@using MiPlata.Models
@inject CajeroService cajeroService

<h3>Login</h3>

<input placeholder="Usuario" @bind="username" />
<input type="password" placeholder="Contraseña" @bind="password" />

<button @onclick="Ingresar">Ingresar</button>


<p>@mensaje</p>
<p>Intentos restantes: @intentos</p>

@code {
    string username;
    string password;
    string mensaje;
    int intentos = 3;

    void Ingresar()
    {
        var user = cajeroService.Login(username, password, out mensaje, out intentos);

        if (user != null)
        {
            mensaje = "Bienvenido " + user.Username;
        }
    }
}